# Root environment for docker-compose. Copy to .env and fill in.
# No real values, credentials, IPs or domains belong in this file or in git.

# --- Postgres ---
POSTGRES_USER=plates
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platesdb

# --- Gateway (nginx) ---
# Port exposed on the host / EC2 instance. Keep 80 for HTTP; add TLS termination later.
HTTP_PORT=80

# --- Backend ---
# Comma-separated list of origins allowed to call the API (the gateway's public URL/domain).
CORS_ORIGINS=http://localhost

# --- Frontend (Expo web build) ---
# Base URL the web build calls for the API. Leave empty ("") to call same-origin
# through the nginx gateway (recommended: gateway proxies /api and /media to backend).
EXPO_PUBLIC_API_URL=

# --- AWS (filled in when infra is provisioned; never commit real values) ---
AWS_REGION=
S3_BUCKET=
STORAGE_BACKEND=local
