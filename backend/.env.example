# No real credentials/IPs/domains here — this file is committed as a template.
DATABASE_URL=postgresql://plates:change-me@db:5432/platesdb
# Comma-separated. Native apps don't send an Origin, so this only matters for the
# web build (gateway origin) and Expo web dev (http://localhost:8081).
CORS_ORIGINS=http://localhost,http://localhost:8081
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./media
AWS_REGION=
S3_BUCKET=
LOW_CONFIDENCE_THRESHOLD=0.4
